{
  "name": "resin-ops-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:push": "npm run db:push --workspace=@resin-ops/db",
    "db:studio": "npm run db:studio --workspace=@resin-ops/db",
    "db:seed": "npm run db:seed --workspace=@resin-ops/api"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  }
}
